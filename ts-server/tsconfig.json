{
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "ES6",
    "module": "CommonJS",
    "baseUrl": "./",
    "paths": {
      "@services/*": [
        "node_modules/services/*"
      ],
      "@utils/*": [
        "node_modules/utils/*"
      ]
    },
    "types": [
      "node"
    ],
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "extends": "expo/tsconfig.base"
}
